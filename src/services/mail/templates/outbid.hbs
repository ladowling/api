<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>You've Been Outbid</title>
  </head>
  <body style='margin:0;padding:0;background-color:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;'>
    <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background-color:#f4f7fb;padding:32px 16px'>
      <tr>
        <td align='center'>
          <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='max-width:640px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(15,23,42,0.08);'>
            <tr>
              <td style='background-color:#ffffff;padding:28px 40px 24px;'>
                <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
                  <tr>
                    <td align='center' style='padding-bottom:20px'>
                      <img src='https://i.ibb.co/fY7p987R/lane-logo-removebg-preview.png' alt='Lane 16' style='display:block;width:180px;max-width:100%;height:auto;margin:0 auto' />
                    </td>
                  </tr>
                  <tr>
                    <td style='text-align:right'>
                      <p style='margin:0 0 8px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#7f8b96;'>Bid Update</p>
                      <h1 style='margin:0;font-size:28px;line-height:1.3;color:#1f2937;'>Hello, {{buyerName}}</h1>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style='padding:0 40px'>
                <div style='height:4px;background-color:#2E7D32'></div>
              </td>
            </tr>

            <tr>
              <td style='padding:32px 40px'>
                <p style='margin:0 0 16px;font-size:16px;line-height:1.7;'>
                  Someone has placed a higher bid on a vehicle you are bidding on. You have been outbid.
                </p>

                <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin:24px 0;border:1px solid #e5e7eb;border-radius:12px;background-color:#f8fafc;'>
                  <tr>
                    <td style='padding:24px'>
                      <p style='margin:0 0 14px;font-size:13px;font-weight:bold;color:#475569;text-transform:uppercase;letter-spacing:0.04em;'>Vehicle</p>
                      <p style='margin:0 0 10px;font-size:15px'><strong>{{vehicleName}}</strong></p>
                      <p style='margin:0 0 10px;font-size:15px'>{{year}} {{make}} {{model}}</p>
                    </td>
                  </tr>
                </table>

                <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin:0 0 24px;border:1px solid #e5e7eb;border-radius:12px;background-color:#fff8f8;'>
                  <tr>
                    <td style='padding:24px'>
                      <p style='margin:0 0 14px;font-size:13px;font-weight:bold;color:#475569;text-transform:uppercase;letter-spacing:0.04em;'>Bid Summary</p>
                      <p style='margin:0 0 10px;font-size:15px'>Your bid: <strong>${{yourBidAmount}}</strong></p>
                      <p style='margin:0;font-size:15px'>New highest bid: <strong style='color:#c0392b'>${{newHighBidAmount}}</strong></p>
                    </td>
                  </tr>
                </table>

                <p style='margin:0;font-size:15px;line-height:1.7;'>Log in to the portal to place a higher bid before the auction closes.</p>
              </td>
            </tr>

            <tr>
              <td style='padding:20px 40px 32px;font-size:13px;line-height:1.6;color:#64748b;'>
                This is an automated notification. For assistance, email support@lane16.com.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
