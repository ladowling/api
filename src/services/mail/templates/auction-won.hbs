<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>You Won the Auction</title>
  </head>
  <body style='margin:0;padding:0;background-color:#f4f7fb;font-family:Arial,Helvetica,sans-serif;color:#1f2937;'>
    <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background-color:#f4f7fb;padding:32px 16px'>
      <tr>
        <td align='center'>
          <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='max-width:640px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(15,23,42,0.08);'>
            <tr>
              <td style='background-color:#ffffff;padding:28px 40px 24px;'>
                <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
                  <tr>
                    <td align='center' style='padding-bottom:20px'>
                      <img src='https://i.ibb.co/fY7p987R/lane-logo-removebg-preview.png' alt='Lane 16' style='display:block;width:180px;max-width:100%;height:auto;margin:0 auto' />
                    </td>
                  </tr>
                  <tr>
                    <td style='text-align:right'>
                      <p style='margin:0 0 8px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#7f8b96;'>Auction Result</p>
                      <h1 style='margin:0;font-size:28px;line-height:1.3;color:#1f2937;'>Congratulations, {{buyerName}}!</h1>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style='padding:0 40px'>
                <div style='height:4px;background-color:#2E7D32'></div>
              </td>
            </tr>

            <tr>
              <td style='padding:32px 40px'>
                <p style='margin:0 0 16px;font-size:16px;line-height:1.7;'>
                  You have won the auction! Your bid was the highest when the auction closed.
                </p>

                <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin:24px 0;border:1px solid #e5e7eb;border-radius:12px;background-color:#f8fafc;'>
                  <tr>
                    <td style='padding:24px'>
                      <p style='margin:0 0 14px;font-size:13px;font-weight:bold;color:#475569;text-transform:uppercase;letter-spacing:0.04em;'>Vehicle Details</p>
                      <p style='margin:0 0 10px;font-size:15px'><strong>Vehicle:</strong> {{vehicleName}}</p>
                      <p style='margin:0 0 10px;font-size:15px'><strong>Make / Model:</strong> {{make}} {{model}}</p>
                      <p style='margin:0 0 10px;font-size:15px'><strong>Year:</strong> {{year}}</p>
                      <p style='margin:0 0 10px;font-size:15px'><strong>Dealership:</strong> {{dealershipName}}</p>
                      <p style='margin:0;font-size:15px'><strong>Winning Bid:</strong> <span style='color:#2E7D32;font-weight:700;'>${{winningBidAmount}}</span></p>
                    </td>
                  </tr>
                </table>

                <p style='margin:0;font-size:15px;line-height:1.7;'>
                  Our team will be in touch with next steps. Log in to the portal to view the full details.
                </p>
              </td>
            </tr>

            <tr>
              <td style='padding:20px 40px 32px;font-size:13px;line-height:1.6;color:#64748b;'>
                This is an automated notification. For assistance, email support@lane16.com.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
