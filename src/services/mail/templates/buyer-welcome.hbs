<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome to Your Buyer Account</title>
  </head>
  <body
    style='
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    '
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color: #f4f7fb; padding: 32px 16px'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='
              max-width: 640px;
              background-color: #ffffff;
              border-radius: 16px;
              overflow: hidden;
              box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            '
          >
            <tr>
              <td
                style='
                  background-color: #ffffff;
                  padding: 28px 40px 24px;
                  color: #1f2937;
                '
              >
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                >
                  <tr>
                    <td align='center' style='padding-bottom: 20px'>
                      <img
                        src='https://www.lane16.com/assets/lane-pic-DM1Pnp5C.png'
                        alt='Lane 16'
                        style='display: block; width: 180px; max-width: 100%; height: auto; margin: 0 auto'
                      />
                    </td>
                  </tr>
                  <tr>
                    <td style='vertical-align: middle; text-align: right'>
                      <p
                        style='
                          margin: 0 0 8px;
                          font-size: 12px;
                          letter-spacing: 0.12em;
                          text-transform: uppercase;
                          color: #7f8b96;
                        '
                      >
                        Buyer Account Created
                      </p>
                      <h1
                        style='
                          margin: 0;
                          font-size: 28px;
                          line-height: 1.3;
                          color: #1f2937;
                        '
                      >
                        Welcome, {{name}}
                      </h1>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style='padding: 0 40px'>
                <div style='height: 4px; background-color: #2E7D32'></div>
              </td>
            </tr>

            <tr>
              <td style='padding: 32px 40px'>
                <p style='margin: 0 0 16px; font-size: 16px; line-height: 1.7'>
                  Your buyer account has been created successfully. Use the
                  credentials below to sign in and start bidding on vehicles.
                </p>

                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='
                    margin: 24px 0;
                    border: 1px solid #e5e7eb;
                    border-radius: 12px;
                    background-color: #f8fafc;
                  '
                >
                  <tr>
                    <td style='padding: 24px'>
                      <p
                        style='
                          margin: 0 0 12px;
                          font-size: 13px;
                          font-weight: bold;
                          color: #475569;
                          text-transform: uppercase;
                          letter-spacing: 0.04em;
                        '
                      >
                        Account Details
                      </p>

                      <p style='margin: 0 0 12px; font-size: 15px'>
                        <strong>Name:</strong> {{name}}
                      </p>

                      <p style='margin: 0 0 12px; font-size: 15px'>
                        <strong>Email:</strong> {{email}}
                      </p>

                      <p style='margin: 0 0 16px; font-size: 15px'>
                        <strong>Phone:</strong> {{phoneNumber}}
                      </p>

                      <p style='margin: 0; font-size: 15px'>
                        <strong>Temporary Password:</strong>
                        <span
                          style="
                            display: inline-block;
                            margin-top: 8px;
                            padding: 10px 14px;
                            background-color: #e8f5e9;
                            border: 1px solid #2E7D32;
                            border-radius: 8px;
                            font-family: 'Courier New', Courier, monospace;
                            font-size: 16px;
                            color: #2E7D32;
                          "
                        >
                          {{tempPassword}}
                        </span>
                      </p>
                    </td>
                  </tr>
                </table>

                <p style='margin: 0 0 16px; font-size: 15px; line-height: 1.7'>
                  This email contains the temporary password for your new Lane16 dealer account. For your security, we recommend signing in and changing this password as soon as possible.
                </p>

                <p style='margin: 0 0 24px; font-size: 15px; line-height: 1.7; color: #475569;'>
                  By accessing or using your Lane16 account, you agree to be bound by Lane16's
                  <a href='https://www.lane16.com/#/terms' target='_blank' style='color: #2E7D32; font-weight: 700; text-decoration: none;'>Terms of Use</a>,
                  and your use of the platform is subject to our
                  <a href='https://www.lane16.com/#/privacy' target='_blank' style='color: #2E7D32; font-weight: 700; text-decoration: none;'>Privacy Policy</a>,
                  which explains how we collect, use, and protect your information as well as any vehicle and bidding data associated with your account.
                </p>

                <table role='presentation' cellpadding='0' cellspacing='0'>
                  <tr>
                    <td style='border-radius: 8px; background-color: #2E7D32;'>
                      <a href='{{portalUrl}}' target='_blank' style='display: inline-block; padding: 14px 32px; font-size: 15px; font-weight: 700; color: #ffffff; text-decoration: none; border-radius: 8px;'>Go to Portal</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
