<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Reset OTP</title>
  </head>
  <body
    style='
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    '
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color: #f4f7fb; padding: 32px 16px'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='
              max-width: 640px;
              background-color: #ffffff;
              border-radius: 16px;
              overflow: hidden;
              box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            '
          >
            <tr>
              <td
                style='
                  background-color: #ffffff;
                  padding: 28px 40px 24px;
                  color: #1f2937;
                '
              >
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                >
                  <tr>
                    <td align='center' style='padding-bottom: 20px'>
                      <img
                        src='https://i.ibb.co/fY7p987R/lane-logo-removebg-preview.png'
                        alt='Lane 16'
                        style='display: block; width: 180px; max-width: 100%; height: auto; margin: 0 auto'
                      />
                    </td>
                  </tr>
                  <tr>
                    <td style='vertical-align: middle; text-align: right'>
                      <p
                        style='
                          margin: 0 0 8px;
                          font-size: 12px;
                          letter-spacing: 0.12em;
                          text-transform: uppercase;
                          color: #7f8b96;
                        '
                      >
                        Password Reset Request
                      </p>
                      <h1
                        style='
                          margin: 0;
                          font-size: 28px;
                          line-height: 1.3;
                          color: #1f2937;
                        '
                      >
                        Hello,
                        {{name}}
                      </h1>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style='padding: 0 40px'>
                <div style='height: 4px; background-color: #2E7D32'></div>
              </td>
            </tr>

            <tr>
              <td style='padding: 32px 40px'>
                <p style='margin: 0 0 16px; font-size: 16px; line-height: 1.7'>
                  Use the one-time password below to reset your account
                  password. This code expires in
                  {{expiresInMinutes}}
                  minutes.
                </p>

                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='
                    margin: 24px 0;
                    border: 1px solid #2E7D32;
                    border-radius: 12px;
                    background-color: #e8f5e9;
                  '
                >
                  <tr>
                    <td style='padding: 24px; text-align: center'>
                      <p
                        style='
                          margin: 0 0 12px;
                          font-size: 13px;
                          font-weight: bold;
                          color: #2E7D32;
                          text-transform: uppercase;
                          letter-spacing: 0.08em;
                        '
                      >
                        One-Time Password
                      </p>

                      <p
                        style="
                          margin: 0;
                          font-size: 32px;
                          font-weight: bold;
                          letter-spacing: 0.32em;
                          color: #2E7D32;
                          font-family: 'Courier New', Courier, monospace;
                        "
                      >
                        {{otp}}
                      </p>
                    </td>
                  </tr>
                </table>

                <p style='margin: 0 0 16px; font-size: 15px; line-height: 1.7'>
                  Enter this OTP together with your new password in the reset
                  password form to complete the change.
                </p>

                <p style='margin: 0; font-size: 15px; line-height: 1.7'>
                  If you did not request a password reset, you can ignore this
                  email.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
